# 轻盈 Lite — AI 后端环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# 大模型 API Key（仅后端使用，绝不下发前端）
AI_API_KEY=

# 兼容 OpenAI 的接口地址（OpenAI / DeepSeek / OpenRouter / 自建网关 等）
AI_BASE_URL=https://api.openai.com/v1

# 模型名
AI_MODEL=gpt-4o-mini

# 单次请求超时（毫秒）
AI_TIMEOUT_MS=20000

# 未配置 AI_API_KEY 时，设为 1 让后端返回「本地模拟」结构化结果（仅本地联调/演示用，生产请删去或设为 0）
AI_DEMO=0

# 服务端口（需与前端 app.config.ts 的 apiBaseUrl 对应）
PORT=3000

# 允许跨域的来源（Web 调试用 *，生产可改为具体域名）
CORS_ORIGIN=*
